# smoke.env - rendered by tests/smoke.sh for both hub and worker configs.
# Every value is explicit; there is no localhost or loopback fallback.

NAME="beaut-smoke"
HUB="@ADDRESS@"
PUBLIC_URL=""
PORT="@HUB_PORT@"
WORK_PORT="@WORK_PORT@"
WORKER_PORT="@WORKER_PORT@"
HUB_BIND="@ADDRESS@"
WORK_BIND="@ADDRESS@"
WORKER_BIND="@ADDRESS@"
NODE_ROLE="@ROLE@"
NODE_ADDRESS="@ADDRESS@"
ROOT="@ROOT@"
DOCKER_CMD="@DOCKER_CMD@"
REPORT_DELAY="2"
HEARTBEAT_DELAY="1"
BACKUP_DELAY="2"
DEATH_TIME="4"
MIN_CPU="1"
MIN_RAM_KB="1"
MIN_DISK_KB="1"
RETAIN_SNAPSHOTS="3"
SCHEDULING_PRIO=(cpu ram disk)
