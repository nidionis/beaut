# beaut — control server configuration (template).
# Copy this file to config.env and adjust values.
# This file is also the schema: it is sourced after config.env and fills any
# variable a stale config.env omits. Environment variables still win.
# Order matters: SERVICE_USER -> SERVICE_ROOT -> STATE_DIR/PUBLISHED_ROOT.

# ---- identity -----------------------------------------------------------------
SERVICE_USER=${SERVICE_USER:-beaut}
BOOTSTRAP_USER=${BOOTSTRAP_USER:-root}
SSH_PRIVATE_KEY=${SSH_PRIVATE_KEY:-$HOME/.ssh/id_ed25519}
SERVICE_ROOT=${SERVICE_ROOT:-$HOME/.$SERVICE_USER}
STATE_DIR=${STATE_DIR:-$SERVICE_ROOT/state}
PUBLISHED_ROOT=${PUBLISHED_ROOT:-$SERVICE_ROOT/site}

# ---- control server -----------------------------------------------------------
SERVER_HOST=${SERVER_HOST:-192.168.8.240}
HTTP_PORT=${HTTP_PORT:-8080}

# ---- WireGuard ----------------------------------------------------------------
WG_PORT=${WG_PORT:-51820}
WG_NETWORK=${WG_NETWORK:-10.66.0.0/24}
WG_SERVER_IP=${WG_SERVER_IP:-10.66.0.1}
# Per-device keys (state/wg/device_*.key). Legacy state/wg_*.key is still read.
WG_KEY_DIRECTORY=${WG_KEY_DIRECTORY:-$STATE_DIR/wg}
WG_PRIVATE_KEY_FILE=${WG_PRIVATE_KEY_FILE:-}
WG_PUBLIC_KEY_FILE=${WG_PUBLIC_KEY_FILE:-}

# ---- devices and invites ------------------------------------------------------
DEVICE_DIRECTORY=${DEVICE_DIRECTORY:-$STATE_DIR/devices}
DEVICE_REGISTRY=${DEVICE_REGISTRY:-$DEVICE_DIRECTORY/registry.tsv}
DEVICE_IDENTITY_DIRECTORY=${DEVICE_IDENTITY_DIRECTORY:-$STATE_DIR/device}
INVITE_DIRECTORY=${INVITE_DIRECTORY:-$STATE_DIR/invites}
INVITE_REGISTRY=${INVITE_REGISTRY:-$INVITE_DIRECTORY/registry.tsv}
INVITE_DEFAULT_USES=${INVITE_DEFAULT_USES:-1}
INVITE_TTL_SECONDS=${INVITE_TTL_SECONDS:-86400}
INVITE_WORD_COUNT=${INVITE_WORD_COUNT:-4}
# Override the default door; otherwise the oldest approved owner/trusted wins.
DOOR_DEVICE_ID=${DOOR_DEVICE_ID:-}

# ---- layout aliases -----------------------------------------------------------
# SITE is the published tree (PUBLISHED_ROOT); DB_DIR is the hidden TSV state
# (STATE_DIR). They let scripts and docs talk about site/db without losing the
# historical names.
SITE=${SITE:-$PUBLISHED_ROOT}
DB_DIR=${DB_DIR:-$STATE_DIR}

# ---- hidden personal tree and journal -----------------------------------------
# SVR_MODE=random (eight lowercase alphanumerics, persisted), sha (derived from
# SVR_SECRET), or plain (explicit SVR, opt-in).
SVR_MODE=${SVR_MODE:-random}
SVR=${SVR:-}
# SVR_PATH pins the hidden URL prefix explicitly (random by default). Changing
# it changes the served path immediately.
SVR_PATH=${SVR_PATH:-}
SVR_SECRET=${SVR_SECRET:-}
# SVR_DIR is the on-disk directory name under SERVICE_ROOT. Leave it empty for
# a random hidden name persisted in SVR_DIR_FILE (for example .svr-a1b2c3d4).
# Changing SVR_DIR moves the existing tree to the new directory.
# The URL prefix is independent and always secret (SVR_PATH_FILE).
SVR_DIR=${SVR_DIR:-}
SVR_ROOT=${SVR_ROOT:-}
SVR_PATH_FILE=${SVR_PATH_FILE:-$STATE_DIR/svr_path}
SVR_DIR_FILE=${SVR_DIR_FILE:-$STATE_DIR/svr_dir}

# Journal: reference-compatible YYYY/MM/DD/<subfolder>/<name>.md date tree,
# a per-host hard-link view, and a git-backed folder.
JOURNAL_DIR=${JOURNAL_DIR:-journal}
JOURNAL_ROOT=${JOURNAL_ROOT:-}
PERSO_DIR=${PERSO_DIR:-perso}
PERSO_ROOT=${PERSO_ROOT:-}
JOURNAL_SUBFOLDER=${JOURNAL_SUBFOLDER:-notes}
PERSO_SUBFOLDER=${PERSO_SUBFOLDER:-fouretout}
JOURNAL_REMOTE=${JOURNAL_REMOTE:-}
PERSO_REMOTE=${PERSO_REMOTE:-}
# "hidden" means user@host:<server hidden tree>/<journal|perso>. JOURNAL_REMOTE_ROOT
# pins the server-side path when the command runs on another machine.
JOURNAL_REMOTE_HOST=${JOURNAL_REMOTE_HOST:-$SERVER_HOST}
JOURNAL_REMOTE_USER=${JOURNAL_REMOTE_USER:-$SERVICE_USER}
JOURNAL_REMOTE_ROOT=${JOURNAL_REMOTE_ROOT:-}
JOURNAL_GIT=${JOURNAL_GIT:-1}
JOURNAL_EDITOR=${JOURNAL_EDITOR:-${EDITOR:-vi}}
SVR_BIN_DIR=${SVR_BIN_DIR:-$HOME/.local/bin}
# When the default bin directory is used, `svr install` also adds it to the
# login shell startup file if it is missing from PATH. Set to 0 to skip.
SVR_INSTALL_PATH=${SVR_INSTALL_PATH:-1}
# Backwards-compatible alias for the old journal directory variable.
JOURNAL_DIRECTORY=${JOURNAL_DIRECTORY:-}

# ---- tokens -------------------------------------------------------------------
TOKEN_TTL_SECONDS=${TOKEN_TTL_SECONDS:-300}

# ---- logging ------------------------------------------------------------------
LOG_LEVEL=${LOG_LEVEL:-info}

# ---- published tree -----------------------------------------------------------
NOT_FOUND_BODY=${NOT_FOUND_BODY:-404}

# ---- virtual attributions -----------------------------------------------------
# Random virtual paths map to resources without creating anything on disk.
# Used by scripts/attribution.sh for secrets, keys, services, requests, ...
ATTRIBUTION_DIRECTORY=${ATTRIBUTION_DIRECTORY:-$STATE_DIR/attributions}
ATTRIBUTION_REGISTRY=${ATTRIBUTION_REGISTRY:-$ATTRIBUTION_DIRECTORY/registry.tsv}
ATTRIBUTION_WORD_COUNT=${ATTRIBUTION_WORD_COUNT:-4}
ATTRIBUTION_SECRET_BYTES=${ATTRIBUTION_SECRET_BYTES:-24}
ATTRIBUTION_PATH_NAMESPACE=${ATTRIBUTION_PATH_NAMESPACE:-v}
ATTRIBUTION_DICTIONARY=${ATTRIBUTION_DICTIONARY:-}

# ---- memory -------------------------------------------------------------------
# The archive step is skipped when available RAM <= total RAM / this divisor.
ARCHIVE_MEMORY_DIVISOR=${ARCHIVE_MEMORY_DIVISOR:-5}
