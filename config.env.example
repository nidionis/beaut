# beaut — configuration du serveur de contrôle (modèle)
# Copiez ce fichier vers config.env et adaptez les valeurs.
# Les lignes commençant par # sont des commentaires.
# Les variables d'environnement priment sur ce fichier (${VAR:-défaut}).

# ---- identité -----------------------------------------------------------------
NAME=${NAME:-beaut}
DIR=${DIR:-$HOME/.$NAME}
STATE_DIR=${STATE_DIR:-$DIR/state}

# ---- serveur de contrôle (DOMAIN / port d'écoute) -----------------------------
DOMAIN=${DOMAIN:-192.168.8.240}
HTTP_PORT=${HTTP_PORT:-8080}

# ---- WireGuard (VPN entre le serveur et les nodes) ---------------------------
WG_PORT=${WG_PORT:-51820}
WG_NET=${WG_NET:-10.66.0.0/24}
WG_SERVER_IP=${WG_SERVER_IP:-10.66.0.1}

# ---- token -------------------------------------------------------------------
TOKEN_TTL_SECONDS=${TOKEN_TTL_SECONDS:-300}

# ---- journal ------------------------------------------------------------------
LOG_LEVEL=${LOG_LEVEL:-info}

# ---- serveur fichier (lecture seule) -----------------------------------------
HTTP_FILE_ROOT=${HTTP_FILE_ROOT:-$DIR/shared}
ERR404=${ERR404:-404}

# ---- mémoire -----------------------------------------------------------------
HIST_MEM_MAX_RATIO=${HIST_MEM_MAX_RATIO:-5}
