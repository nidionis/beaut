# beaut configuration — copy to config.env, edit, then `chmod 600 config.env`.
# Sourced as bash: quoting is honoured; do NOT use a bare ~ (use $HOME).
# Every value here can also be overridden from the environment (BEAUT_*).

# ---- identity ---------------------------------------------------------------
DOMAIN="beaut.example.org"       # public name of the hub (serves :8888, ssh tunnels)
ROLES="client"                   # comma list, composable: hub,worker,client
NAME="$(hostname -s 2>/dev/null || echo beaut)"   # this host's name in the pool

# ---- hub: HTTP app ----------------------------------------------------------
ADMIN_PORT=8888                  # stats + enrollment endpoints
ADMIN_BIND="0.0.0.0"             # bind address of the HTTP app
ADMINS="admin@example.org"       # space-separated admin mail addresses

# ---- hub: reverse ssh tunnels -------------------------------------------------
TUNNEL_USER="tunnel"             # restricted hub account workers connect to
TUNNEL_PORT=22                   # hub sshd port workers dial out to
TUNNEL_PORT_RANGE="20000-20999"  # ports reserved on the hub for worker tunnels

# ---- hub: mail inscription (join@$DOMAIN) -------------------------------------
MAIL_POLL_SECONDS=60             # mailbox polling interval
MAIL_FETCH_CMD="mpop -q"         # fetch command (mpop / fetchmail), fills MAILDIR
MAILDIR="$HOME/.beaut/Maildir"   # where fetched mail lands
MAIL_FROM="join@$DOMAIN"         # From: of outgoing replies
MSMTP_ACCOUNT="default"          # msmtp -a <account>; credentials live in ~/.msmtprc (0600)
MAIL_ACCOUNT_PATTERN="join@*"    # accepted inbound recipients (* = wildcard)

# ---- worker: donated share ----------------------------------------------------
GIVE_PCT=50                      # percentage of CPU/RAM/disk donated (1..100)
WORKER_USER="beaut"              # local account workloads run as on this worker

# ---- state ----------------------------------------------------------------
STATE_DIR="/var/lib/beaut"       # TSV state (workers/users/tokens/sessions); 0700
LOG_LEVEL="info"                 # debug|info|warn|error
TOKEN_TTL_SECONDS=604800         # one-time tokens expire after 7 days

# ---- tiers: name cpu mem_mib disk_gib (-1 = half of chosen worker's free) ----
TIERS="
guest       1    2048  16
registered  4    4096  32
admin      -1      -1  -1
"
