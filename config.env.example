# beaut configuration — edit and save as config.env
# Mandatory keys: BEAUT_PASSWORD, ROLE
BEAUT_PASSWORD="changeme-admin-bootstrap"     # admin bootstrap password (required)
ROLE="worker"                           # orchestrator|router|worker
NAME=beaut
PREFIX="~/.$NAME"

# Orchestrator address (required for non-orchestrator roles)
IP_ORCHESTRATOR=""
IPV4_ROUTER=''
IPV6_ROUTER=''
IP_ROUTER="$IPV4_ROUTER"
IP_DOMAIN="$IP_ROUTER"

# Peers / workers (local address added by default)
NEIGHBOURS=""
WORKERS="$NEIGHBOURS"

# SSH accepted keys file (one public key per line)
SSH_ACCEPTED_KEYS_FILE="$PREFIX/ssh/authorized_keys.pub"

# Optional overrides (see scripts/env.sh for defaults)
# BEAUT_STATE_DIR="$PREFIX/var"
# BEAUT_ETC_DIR="$PREFIX/etc
# BEAUT_HEARTBEAT_S=30
# BEAUT_POLL_S=3
# BEAUT_STALE_S=90
# BEAUT_ALLOW_EXEC=0
# BEAUT_EXEC_DOMAINS=""
# SERVICE_USER="$NAME"
# SERVICE_GROUP="$NAME"
