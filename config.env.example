# beaut configuration — copy to config.env and edit.
# Sourced as bash: quoting is honoured, but do NOT use a bare ~ (use $HOME).
#
# Required:
BEAUT_PASSWORD="changeme-admin-bootstrap"   # admin bootstrap password
ROLE="worker"                               # comma list: orchestrator,router,worker,client
NAME=beaut
PREFIX="$HOME/.$NAME"                       # quoted ~ does not expand — use $HOME
BIN_DIR="$HOME/.bin"                        # where the beaut executable goes

# Addresses (IP_ORCHESTRATOR is required for every non-orchestrator role)
IP_ORCHESTRATOR=""
IPV4_ROUTER=""
IPV6_ROUTER=""
IP_ROUTER="$IPV4_ROUTER"
IP_DOMAIN="$IP_ROUTER"

# Peers (the local address is never added automatically)
NEIGHBOURS=""
WORKERS="$NEIGHBOURS"
FRIENDS=""

# SSH accepted keys file (one public key per line)
SSH_ACCEPTED_KEYS_FILE="$PREFIX/ssh/authorized_keys.pub"

# Optional overrides (defaults shown)
# BEAUT_IF=lo                          # auto-detected from the default route
# BEAUT_HEARTBEAT_S=30
# BEAUT_POLL_S=3
# BEAUT_STALE_S=90
# BEAUT_ALLOW_EXEC=0                   # keep 0 unless you want remote exec
# BEAUT_EXEC_DOMAINS=""                # comma list; empty = all
# BEAUT_EXEC_TIMEOUT_S=300
# BEAUT_NICE=10                        # nice level for every executed task
# BEAUT_MAX_CONCURRENT=1               # processes per client; beyond → throttle/kill
# BEAUT_RATE_LIMIT=60                  # accepted requests per client per 60 s
# BEAUT_ABUSE_ACTION=nice              # nice | kill
# SCHEDULER_RESERVE_NODES=0            # reserved remote peers; self always eligible
# BEAUT_PORT=7331                      # hub/peer TCP port
# BEAUT_HUB_RATE=240                   # verified records per client per minute
# STEGANO_MAX_SIZE=536870912           # 512 MiB per transfer
