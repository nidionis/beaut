# beaut configuration — edit and save as config.env
# Mandatory keys: BEAUT_PASSWORD, ROLE
BEAUT_PASSWORD="changeme-admin-bootstrap"     # admin bootstrap password (required)
ROLE="orchestrator"                           # orchestrator|router|worker|client

# Orchestrator address (required for non-orchestrator roles)
IP_ORCHESTRATOR="127.0.0.1"
IP_ROUTER="$(ip -4 addr show 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | grep -v '^127\.' | head -1 || echo 127.0.0.1)"
IP_DOMAIN="$IP_ROUTER"

# Peers / workers (local address added by default)
NEIGHBOURS="$IP_ROUTER"
WORKERS="$IP_ROUTER"

# SSH accepted keys file (one public key per line)
SSH_ACCEPTED_KEYS_FILE="/etc/beaut/ssh_accepted_keys.pub"

# Optional overrides (see scripts/env.sh for defaults)
# BEAUT_STATE_DIR="/var/lib/beaut"
# BEAUT_ETC_DIR="/etc/beaut"
# BEAUT_HEARTBEAT_S=30
# BEAUT_POLL_S=3
# BEAUT_STALE_S=90
# BEAUT_ALLOW_EXEC=0
# BEAUT_EXEC_DOMAINS=""
# SERVICE_USER="beaut"
# SERVICE_GROUP="beaut"
