# beaut — control server configuration (template).
# Copy this file to config.env and adjust values.
# This file is also the schema: it is sourced after config.env and fills any
# variable a stale config.env omits. Environment variables still win.
# Order matters: SERVICE_USER -> SERVICE_ROOT -> STATE_DIR/PUBLISHED_ROOT.

# ---- identity -----------------------------------------------------------------
SERVICE_USER=${SERVICE_USER:-beaut}
BOOTSTRAP_USER=${BOOTSTRAP_USER:-root}
SSH_PRIVATE_KEY=${SSH_PRIVATE_KEY:-$HOME/.ssh/id_ed25519}
SERVICE_ROOT=${SERVICE_ROOT:-$HOME/.$SERVICE_USER}
STATE_DIR=${STATE_DIR:-$SERVICE_ROOT/state}
PUBLISHED_ROOT=${PUBLISHED_ROOT:-$SERVICE_ROOT/shared}

# ---- control server -----------------------------------------------------------
SERVER_HOST=${SERVER_HOST:-192.168.8.240}
HTTP_PORT=${HTTP_PORT:-8080}

# ---- WireGuard ----------------------------------------------------------------
WG_PORT=${WG_PORT:-51820}
WG_NETWORK=${WG_NETWORK:-10.66.0.0/24}
WG_SERVER_IP=${WG_SERVER_IP:-10.66.0.1}

# ---- tokens -------------------------------------------------------------------
TOKEN_TTL_SECONDS=${TOKEN_TTL_SECONDS:-300}

# ---- logging ------------------------------------------------------------------
LOG_LEVEL=${LOG_LEVEL:-info}

# ---- published tree -----------------------------------------------------------
NOT_FOUND_BODY=${NOT_FOUND_BODY:-404}

# ---- virtual attributions -----------------------------------------------------
# Random virtual paths map to resources without creating anything on disk.
# Used by scripts/attribution.sh for secrets, keys, services, requests, ...
ATTRIBUTION_DIRECTORY=${ATTRIBUTION_DIRECTORY:-$STATE_DIR/attributions}
ATTRIBUTION_REGISTRY=${ATTRIBUTION_REGISTRY:-$ATTRIBUTION_DIRECTORY/registry.tsv}
ATTRIBUTION_WORD_COUNT=${ATTRIBUTION_WORD_COUNT:-4}
ATTRIBUTION_SECRET_BYTES=${ATTRIBUTION_SECRET_BYTES:-24}
ATTRIBUTION_PATH_NAMESPACE=${ATTRIBUTION_PATH_NAMESPACE:-v}
ATTRIBUTION_DICTIONARY=${ATTRIBUTION_DICTIONARY:-}

# ---- memory -------------------------------------------------------------------
# The archive step is skipped when available RAM <= total RAM / this divisor.
ARCHIVE_MEMORY_DIVISOR=${ARCHIVE_MEMORY_DIVISOR:-5}
