[Unit]
Description=@BEAUT_NAME@ raw TCP router
After=network-online.target beaut-hub.service
Wants=network-online.target
Wants=beaut-hub.service

[Service]
Type=simple
User=@BEAUT_USER@
Group=@BEAUT_GROUP@
Environment=BEAUT_CONFIG=@BEAUT_CONFIG@
ExecStart=@BEAUT_BIN@ router run
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
