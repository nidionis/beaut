[Unit]
Description=@BEAUT_NAME@ worker
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=@BEAUT_USER@
Group=@BEAUT_GROUP@
Environment=BEAUT_CONFIG=@BEAUT_CONFIG@
ExecStart=@BEAUT_BIN@ worker serve
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
