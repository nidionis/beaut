[Unit]
Description=@BEAUT_NAME@ hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BEAUT_USER@
Group=@BEAUT_GROUP@
Environment=BEAUT_CONFIG=@BEAUT_CONFIG@
ExecStart=@BEAUT_BIN@ hub serve
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
