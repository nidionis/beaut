#!/usr/bin/env bash
# sbeaut — privileged resources (network) granted to SERVICE_USER via scoped
# sudo. Installed root:root as /usr/local/sbin/s<SERVICE_USER>. It only runs the
# root-owned copy of the scripts, never the user-writable tree.
set -euo pipefail

ROOT_LIB_DIR=/usr/local/lib/beaut

case "${1:-all}" in
  all|"") bash "$ROOT_LIB_DIR/scripts/network.sh" setup ;;
  *)      bash "$ROOT_LIB_DIR/scripts/network.sh" "$@" ;;
esac
