# beaut configuration (sourced as Bash).
#
# Copy to conf/conf.env and edit. conf/node.env is generated on each machine by
# the deploy scripts and is loaded after this file.

# ---- identity ---------------------------------------------------------------
NAME="beaut"
ADMIN_USER="${ADMIN_USER:-${NAME:-master}}"
WORKER_USER="${WORKER_USER:-worker}"

# ---- network ----------------------------------------------------------------
# Explicit addresses only. Never use localhost or 127.0.0.1.
# HUB is the address workers use to reach the hub. WireGuard is not implemented
# yet, so use an address that is already reachable (LAN or public).
HUB="10.66.0.1"
PUBLIC_URL=""

PORT="8081"
WORK_PORT="8090"
WORKER_PORT="8091"
HUB_BIND="0.0.0.0"
WORK_BIND="0.0.0.0"
WORKER_BIND="0.0.0.0"

# ---- timing (seconds) -------------------------------------------------------
# HEARTBEAT_DELAY must stay comfortably below DEATH_TIME.
REPORT_DELAY="60"
HEARTBEAT_DELAY="5"
BACKUP_DELAY="60"
DEATH_TIME="10"

# ---- placement --------------------------------------------------------------
SCHEDULING_PRIO=(cpu ram disk)
MIN_CPU="1"
MIN_RAM_KB="262144"
MIN_DISK_KB="1048576"

# ---- paths ------------------------------------------------------------------
# ROOT defaults to $HOME/.beaut. On deploy, the default is resolved against the
# remote account's home, so nodes may have different home directories. Set an
# explicit absolute ROOT when every node must use the same path.
ROOT="${ROOT:-$HOME/.beaut}"
STATE_DIR="$ROOT/state"
LOG_DIR="$ROOT/logs"
CONTAINER_DIR="$ROOT/containers"
SNAPSHOT_DIR="$ROOT/snapshots"

# ---- worker -----------------------------------------------------------------
# Must run non-interactively for the account that owns the worker unit.
# first-conn grants passwordless Docker to the admin and worker accounts.
DOCKER_CMD="${DOCKER_CMD:-sudo docker}"
RETAIN_SNAPSHOTS="7"

# ---- deployment -------------------------------------------------------------
# SSH destination for bin/deploy-worker.sh and the worker's real address used in
# node.env. Both are explicit; there is no localhost fallback.
# WORKER_TARGET may be an address or user@address.
WORKER_TARGET=""
WORKER_ADDRESS=""
SSH_USER=""
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o LogLevel=ERROR"

# ---- limits -----------------------------------------------------------------
HTTP_MAX_BODY="10737418240"
