#!/usr/bin/env bash
# @NAME@ — beaut CLI (generated from templates/beaut-cli.sh.tmpl)
set -uo pipefail
. "@LIB_DIR@/beaut-lib"

cmd="${1:-help}"; shift || true

case "$cmd" in
  init)
    need_pw
    lvl=$("$T" auth "$BEAUT_PASSWORD") || { echo "identity not approved" >&2; exit 1; }
    echo "level=$lvl | $("$T" role) | ip=$(myip)" ;;

  join)
    need_pw
    "$T" join "@ENV_DIR@/pending.tsv" "$BEAUT_PASSWORD"
    echo "ask an admin: $NAME approve <id> <level>" ;;

  approve)
    need_pw
    [ "$#" -ge 1 ] || { echo "usage: $NAME approve <id> [level]" >&2; exit 1; }
    "$T" approve "@ENV_DIR@/pending.tsv" "@ENV_DIR@/priv.tsv" "$1" "${2:-2}" \
      && echo "approved $1 level ${2:-2}" ;;

  ban)
    need_pw
    [ "$#" -eq 1 ] || { echo "usage: $NAME ban <id>" >&2; exit 1; }
    enc=$("$T" encode "$1" | cut -c1-3)
    if [ -f "@ENV_DIR@/priv.tsv" ]; then
      grep -v "$enc" "@ENV_DIR@/priv.tsv" > "@ENV_DIR@/priv.tsv.t" || true
      mv "@ENV_DIR@/priv.tsv.t" "@ENV_DIR@/priv.tsv"
    fi
    echo "banned $1" ;;

  heartbeat)
    need_pw
    "$T" heartbeat "$LOG" "$me" "$(myip)" "$BEAUT_PASSWORD" ;;

  peers)
    need_pw
    "$T" peers "$LOG" "$BEAUT_PASSWORD" ;;

  pick)
    need_pw
    "$T" pick "$LOG" "$BEAUT_PASSWORD" ;;

  retain)
    "$T" retain ;;

  run)
    need_pw
    dom="${1:?domain}"; shift || true
    [ "$#" -gt 0 ] || { echo "usage: $NAME run <domain> <cmd>" >&2; exit 1; }
    task="$*"
    { read -r best; read -r next; } < <("$T" pick "$LOG" "$BEAUT_PASSWORD")
    [ -n "$best" ] || { echo "no worker available" >&2; exit 1; }
    "$T" post "$LOG" "$me" task \
      "${best}::user=${USER:-unknown}::NPROC=$("$T" cores)::domain=${dom}::${task}" \
      "$BEAUT_PASSWORD"
    echo "posted -> $best (next: ${next:-none})" ;;

  watch)
    need_pw
    offset=0; seen=""
    trap 'exit 0' TERM INT
    while :; do
      out=$("$T" read "$LOG" "$offset" "$BEAUT_PASSWORD" 2>/dev/null || true)
      cnt=$("$T" read "$LOG" "$offset" "$BEAUT_PASSWORD" 2>&1 >/dev/null || echo 0)
      while IFS=$'\t' read -r ts worker action payload; do
        [ -n "${worker:-}" ] || continue
        [ "$worker" = "$me" ] && continue
        case "$action" in
          heartbeat)
            case " $seen " in *" $worker "*) ;; *)
              seen="$seen $worker"; alert "WORKER_CONNECT $worker ${payload%%:*}" ;;
            esac ;;
          task)
            target="${payload%%::*}"; rest="${payload#*::}"
            nproc="${rest%%::*}"; rest="${rest#*::}"
            dom="${rest%%::*}"; rest="${rest#*::}"; dom="${dom#domain=}"
            [ "$target" = "$(myip)" ] || [ "$target" = "*" ] || continue
            if [ "$("$T" role | awk '{print $1}')" = router ]; then
              "$T" post "$LOG" "$me" route "${target}::${dom}" "$BEAUT_PASSWORD"
              alert "TRAFFIC_ROUTE $dom -> $target"
              continue
            fi
            if [ "${BEAUT_ALLOW_EXEC:-0}" != 1 ]; then
              alert "EXEC_BLOCKED $dom from $worker (BEAUT_ALLOW_EXEC=0)"; continue
            fi
            if [ -n "${BEAUT_EXEC_DOMAINS:-}" ] && [[ ",${BEAUT_EXEC_DOMAINS}," != *",${dom},"* ]]; then
              alert "EXEC_BLOCKED domain=$dom not in allowlist"; continue
            fi
            alert "EXEC_START $dom from $worker"
            if timeout "${BEAUT_EXEC_TIMEOUT_S:-300}" bash -c "$rest"; then
              "$T" post "$LOG" "$me" result "$(myip)::${dom}" "$BEAUT_PASSWORD"
            else
              "$T" post "$LOG" "$me" fail "$(myip)::${dom}" "$BEAUT_PASSWORD"
            fi ;;
        esac
      done <<< "$out"
      offset=$(( offset + ${cnt:-0} ))
      sleep "${BEAUT_POLL_S:-3}"
    done ;;

  help|*)
    cat >&2 <<H
usage: $NAME <cmd> [args]
  init                 verify identity + show role
  join                 request an identity (writes pending.tsv)
  approve <id> [lvl]   approve a pending identity (default level 2)
  ban <id>             remove an identity
  heartbeat            post one heartbeat
  peers                list live peers
  pick                 show the scheduler's best/next worker
  run <domain> <cmd>   post a task to the best worker
  watch                dispatch loop (run this as the service)
  retain               prune/archive the log
H
    ;;
esac
