#!/usr/bin/env bash
set -uo pipefail
. @LIB_DIR@/beaut-lib
E="@BEAUT_ETC_DIR@"
T="@BEAUT_TOOL@"
[ "$#" -eq 1 ] || { echo "usage: beaut-ban <id>" >&2; exit 1; }
enc="$("$T" encode "$1" | cut -c1-3)"
[ -f "$E/priv.tsv" ] || exit 0
grep -v "$enc" "$E/priv.tsv" > "$E/priv.tsv.t" || true
mv "$E/priv.tsv.t" "$E/priv.tsv"
echo "banned $1"
