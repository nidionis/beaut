# beaut shared shell helpers — sourced by the beaut CLI
CONF="@CONF@"
SECRET="@SECRET@"
set -a
[ -r "$CONF" ] && . "$CONF"
[ -r "$SECRET" ] && . "$SECRET"
set +a

T="@TOOL@"
LOG="@STATE_DIR@/log.enc"
NAME="@NAME@"
me=$(hostname -s)

myip() {
  ip -4 addr show "${BEAUT_IF:-lo}" 2>/dev/null \
    | awk '/inet /{print $2}' | cut -d/ -f1 | head -1
}

need_pw() {
  : "${BEAUT_PASSWORD:?BEAUT_PASSWORD unset — put it in $CONF}"
}

alert() {
  printf '%s %s\n' "$(date -Is)" "$*" >> "@STATE_DIR@/connections.log"
}
