# beaut configuration (sourced as Bash).
#
# Copy to conf.env and edit. `conf.env` is deployment-specific and kept out of
# git. A generated ~/.beaut/node.env is loaded after this file on each node, so
# deploy-specific values win.

# ---- layout -----------------------------------------------------------------
ROOT="${ROOT:-$HOME/.beaut}"
STATE_DIR="$ROOT/state"
LOG_DIR="$ROOT/logs"

# Folder tree served by the hub. Empty uses $BEAUT_ROOT/site.
SITE_DIR=""

# ---- hub listener -----------------------------------------------------------
PORT="8081"
HUB_BIND="0.0.0.0"

# The only URL clients use. There is no localhost or LAN-IP fallback.
PUBLIC_URL="https://beaut.example.net"

# ---- deployment -------------------------------------------------------------
# SSH destination workers use for reverse tunnels. Leave empty when no worker
# needs a tunnel.
HUB_SSH=""

# Optional public relay: SSH target and loopback port on that machine.
# Leave empty to let beaut ignore this feature (an existing relay unit is
# then left untouched).
HUB_RELAY=""
HUB_RELAY_PORT="18080"

# Default SSH login for worker rows whose ssh field is empty.
SSH_USER=""

# ---- this worker ------------------------------------------------------------
# Empty uses the local host name.
WORKER_NAME=""
WORKER_HOST=""
WORKER_PORT="8090"
WORKER_BIND="0.0.0.0"

# ---- workers ----------------------------------------------------------------
# name | host | port | ssh target (optional) | tunnel port (optional)
#
# ssh target "local" -> the worker runs on the hub machine and is installed
#                      without SSH.
# ssh target empty   -> SSH_USER@host, or host when SSH_USER is empty.
# tunnel port empty  -> the hub reaches the worker directly at host:port.
# tunnel port set    -> the worker keeps an SSH reverse tunnel to HUB_SSH and
#                       the hub tries 127.0.0.1:<tunnel port> first.
WORKERS=(
  # "w0|10.0.0.11|8090|user@10.0.0.11|19100"
  # "w1|10.0.0.12|8090|local|"
)
