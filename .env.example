# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement.
# .env est ignoré par git (ne jamais committer de config locale).
# Les variables d'environnement priment sur ce fichier (${VAR:-défaut}).

# ---- identity -----------------------------------------------------------------
NAME=${NAME:-beaut}
DIR=${DIR:-$HOME/.$NAME}

# ---- hub (serveur de contrôle / orchestrateur) --------------------------------
HUB_HOST=${HUB_HOST:-127.0.0.1}
HUB_PORT=${HUB_PORT:-2222}
HUB_USER=${HUB_USER:-$USER}

# ---- timing -------------------------------------------------------------------
WORKER_STALE_SECONDS=${WORKER_STALE_SECONDS:-60}
HEARTBEAT_INTERVAL=${HEARTBEAT_INTERVAL:-15}
LEASE_TTL_SECONDS=${LEASE_TTL_SECONDS:-300}

# ---- auth : authorized_keys "as-is" -------------------------------------------
CLIENT_KEYS=${CLIENT_KEYS:-$DIR/clients}
WORKER_KEYS=${WORKER_KEYS:-$DIR/workers}

# ---- état ---------------------------------------------------------------------
STATE_DIR=${STATE_DIR:-$DIR/state}
LOG_LEVEL=${LOG_LEVEL:-info}
