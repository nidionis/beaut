# lab/config.advanced.env — optional overlay, sourced after config.env.
# Everything here is non-essential to boot the lab; remove a block to fall
# back to the defaults baked into lab/lib/lab.sh.

## ---- domain router (single ingress, routes by Host) --------------------------
#ROUTER_NAME="router-1" #adding in /etc/hosts ?
#ROUTER_ADDR="10.42.0.2"
#ROUTER_LISTEN="0.0.0.0:443"
#ROUTER_TLS="on"                  # TLS terminates here; hub stays plain :8888
#ROUTER_HEALTH_PATH="/health"
#ROUTER_TIMEOUT_SECONDS=5
#ROUTER_STICKY=1                  # keep a client on the same upstream when possible
#ROUTER_FAILOVER="on"             # re-point a route to the next neighbour
#
## host-pattern              upstream                        role
#ROUTER_ROUTES="
#lab.beaut.internal          beaut.lab:8888                  primary
#*.lab.beaut.internal        beaut.lab:8888                  primary
#admin.lab.beaut.internal    beaut.lab:8888                  admin
#"
#
## ---- neighbours (trusted workers, promotable to orchestrator) ----------------
## name     address      priority  promote  trust
#NEIGHBOURS="
#orch-b     10.42.0.11   90        1        trusted
#orch-c     10.42.0.12   80        1        trusted
#worker-1   10.42.0.21   10        0        donated
#"
## Only rows with promote=1 and trust=trusted are eligible to replace the
## orchestrator. Eligible neighbours keep a warm copy of the state dir and a
## live heartbeat; promotion bumps ORCHESTRATOR_TERM (fencing token).
#
## ---- failover / promotion policy --------------------------------------------
#FAILOVER_HEARTBEAT_SECONDS=5     # heartbeat interval
#FAILOVER_LEASE_SECONDS=30        # leader lease; expiry opens an election
#FAILOVER_QUORUM=2                # trusted neighbours that must agree to promote
#FAILOVER_DEMOTE_ON_RETURN=1      # old leader rejoins as follower, never splits
#
## ---- dispatch / leases -------------------------------------------------------
#DISPATCH_POLICY="priority"       # priority|memory|round-robin (priority today)
#SESSION_LEASE_SECONDS=60         # client must renew, or the command is killed
#KILL_GRACE_SECONDS=5             # SIGTERM -> SIGKILL delay
#
## ---- worker: donated share ---------------------------------------------------
#GIVE_PCT=50
#
## ---- per-command resource caps (worker-exec) ---------------------------------
## Same knobs as the SSH examples: cgroups v2 first, then nice/ionice/ulimit.
#EXEC_CPU_QUOTA="100%"            # systemd-run -p CPUQuota=
#EXEC_MEMORY_MAX="512G"           # systemd-run -p MemoryMax=
#EXEC_IO_WEIGHT=10                # systemd-run -p IOWeight=
#EXEC_NICE=19                     # nice -n
#EXEC_IONICE_CLASS=3              # ionice -c (3 = idle)
#EXEC_ULIMIT_V_KB=524288          # ulimit -v (KiB)
#EXEC_WRAPPER="systemd-run --scope -p CPUQuota=$EXEC_CPU_QUOTA -p MemoryMax=$EXEC_MEMORY_MAX -p IOWeight=$EXEC_IO_WEIGHT"
