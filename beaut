#!/usr/bin/env bash
# beaut - minimal hub/worker fabric.
#
# This CLI is the only general argument parser. Files under lib/ are sourced
# function definitions; bin/ contains argument-free runtime entrypoints.
set -uo pipefail

_self="${BASH_SOURCE[0]}"
_self="$(readlink -f -- "$_self" 2>/dev/null || printf '%s' "$_self")"
BEAUT_ROOT="$(cd -- "$(dirname -- "$_self")" && pwd)"
unset _self
export BEAUT_ROOT

# shellcheck source=lib/bootstrap.sh
. "$BEAUT_ROOT/lib/bootstrap.sh"

usage() { printf '%s\n' "$(<"$BEAUT_ROOT/share/usage.txt")"; }

main() {
  local cmd="${1:-}" mode target

  case "$cmd" in
    help|-h|--help|"") usage; return 0 ;;
    version|--version) printf 'beaut v0.2\n'; return 0 ;;
  esac

  case "$cmd" in
    hub)
      shift
      [[ "${1:-serve}" == serve ]] || die "usage: beaut hub serve"
      need_exec "$BEAUT_ROOT/bin/beaut-hub"
      exec "$BEAUT_ROOT/bin/beaut-hub"
      ;;
    worker)
      shift
      [[ "${1:-serve}" == serve ]] || die "usage: beaut worker serve"
      need_exec "$BEAUT_ROOT/bin/beaut-worker"
      exec "$BEAUT_ROOT/bin/beaut-worker"
      ;;
  esac

  load_config

  case "$cmd" in
    status)
      shift
      mode="${1:-}"
      case "$mode" in
        "") status_table ;;
        --json) status_body ;;
        *) die "usage: beaut status [--json]" ;;
      esac
      ;;
    resources)
      shift
      mode="${1:-}"
      case "$mode" in
        "") resources_human ;;
        --raw) resources_raw ;;
        --json) resources_json ;;
        *) die "usage: beaut resources [--raw|--json]" ;;
      esac
      ;;
    run)
      shift
      target="${1:-}"
      [[ -n "$target" ]] || die "usage: beaut run PROJECT_FOLDER"
      validate_config
      state_init
      hub_pack_project "$target"
      ;;
    jobs)
      validate_config
      state_init
      job_list | jq .
      ;;
    doctor) validate_config; doctor ;;
    deploy)
      shift
      target="${1:-}"
      case "$target" in
        hub) exec "$BEAUT_ROOT/bin/deploy-hub.sh" ;;
        worker) exec "$BEAUT_ROOT/bin/deploy-worker.sh" ;;
        *) die "usage: beaut deploy hub|worker" ;;
      esac
      ;;
    first-conn)
      shift
      exec "$BEAUT_ROOT/bin/first-conn.sh" "$@"
      ;;
    *) die "unknown command: $cmd (try: beaut help)" ;;
  esac
}

main "$@"
