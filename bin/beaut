#!/usr/bin/env bash
# beaut — recycle spare compute by mutualising resources.
# Roles (composable, from ROLES in config.env or `--roles`): hub, worker, client.
set -euo pipefail

BEAUT_ROOT="${BEAUT_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
export BEAUT_ROOT
# shellcheck source=../lib/common.sh
. "$BEAUT_ROOT/lib/common.sh"
# shellcheck source=../lib/auth.sh
. "$BEAUT_ROOT/lib/auth.sh"

usage() {
    cat <<EOF
beaut $BEAUT_VERSION — recycle spare compute by mutualising resources

usage: beaut [-c config] [--roles hub,worker,client] [-v] <command> [args]

common
  help, --help               this text
  version                    print version
  config                     show effective configuration (secrets masked)
  roles                      list roles enabled on this host
  status                     local state summary (workers/users/tokens/sessions)
  user list|pending          list users / pending inscriptions
  user add <email> [pubkey]  add a (pending, guest) user
  user approve <email>       promote to registered tier
  user level <email> <lvl>   set guest|registered|admin
  user rm <email>            remove a user
  token issue <email>        issue a one-time client token
  token check <token>        print owner if token is valid
  token burn <token>         consume a token
  tier [name]                show tier table / one tier (cpu mem_mib disk_gib)

daemon                     foreground supervisor used by beaut.service:
                             hub → serve + mail-poll, worker → enroll/tunnel

hub   (role: hub, serves \$DOMAIN)
  serve                      HTTP stats + enrollment app on :\$ADMIN_PORT  [step 2]
  mail-poll                  poll mailbox, handle join@<domain>           [step 6]

worker (role: worker, donates resources)
  enroll [N]                 donate N% (default GIVE_PCT) and join the hub  [step 3]
  worker-exec <cmd...>       run a command under the donated quota         [step 3]

client (role: client, submits work)
  run <cmd...>               run a command on a fitting worker             [step 4]
  vm                         open a graphical VM session (SPICE over SSH)  [step 5]

Commands tagged [step N] are planned and currently exit 64 "not implemented".
Roles gate commands: a command of a disabled role is refused.
EOF
}

not_impl() { die "'$1' is not implemented yet (planned for $2)"; }

# require_role <role> — refuse commands for roles not enabled on this host.
require_role() {
    has_role "$1" || die "role '$1' is not enabled on this host (ROLES=$ROLES)"
}

mask() { [ -z "$1" ] && echo '""' || printf '"%s…"\n' "${1:0:3}"; }

cmd_config() {
    local k
    echo "config_file=${BEAUT_CONFIG_FILE:-<none, defaults>}"
    for k in DOMAIN ROLES NAME ADMIN_PORT ADMIN_BIND ADMINS TUNNEL_USER TUNNEL_PORT \
             TUNNEL_PORT_RANGE MAIL_POLL_SECONDS MAIL_FETCH_CMD MAILDIR MAIL_FROM \
             MSMTP_ACCOUNT MAIL_ACCOUNT_PATTERN GIVE_PCT WORKER_USER STATE_DIR \
             LOG_LEVEL TOKEN_TTL_SECONDS; do
        case "$k" in
            *PASS*|*SECRET*|*TOKEN_VALUE*) printf '%s=%s\n' "$k" "$(mask "${!k}")" ;;
            *) printf '%s=%q\n' "$k" "${!k}" ;;
        esac
    done
    printf 'TIERS=\n'; tier_names | while read -r t; do printf '  %-11s %s\n' "$t" "$(tier_spec "$t")"; done
}

cmd_status() {
    init_state
    local f
    echo "state_dir=$STATE_DIR"
    echo "roles=$(roles)"
    for f in "${state_files[@]}"; do
        printf '%-13s %s rows\n' "$f" "$(wc -l < "$(state_path "$f")")"
    done
    printf 'pending_users %s\n' "$(users_pending | wc -l)"
}

cmd_user() {
    init_state
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list)    users_list ;;
        pending) users_pending ;;
        add)     [ $# -ge 1 ] || die "usage: beaut user add <email> [pubkey]"
                 user_add "$1" "${2:-}" guest && info "added $1 (pending)" ;;
        approve) [ $# -eq 1 ] || die "usage: beaut user approve <email>"
                 user_approve "$1" && info "approved $1 → registered" ;;
        level)   [ $# -eq 2 ] || die "usage: beaut user level <email> <guest|registered|admin>"
                 user_set_level "$1" "$2" && info "$1 → $2" ;;
        rm)      [ $# -eq 1 ] || die "usage: beaut user rm <email>"
                 user_remove "$1" && info "removed $1" ;;
        *)       die "unknown user command: $sub" ;;
    esac
}

cmd_token() {
    init_state
    local sub="${1:-}"; shift || true
    case "$sub" in
        issue) [ $# -eq 1 ] || die "usage: beaut token issue <email>"; token_issue "$1" ;;
        check) [ $# -eq 1 ] || die "usage: beaut token check <token>"
               token_check "$1" || { BEAUT_EXIT=2 die "token invalid, used or expired"; } ;;
        burn)  [ $# -eq 1 ] || die "usage: beaut token burn <token>"
               token_burn "$1" || { BEAUT_EXIT=2 die "token invalid, used or expired"; } ;;
        *)     die "usage: beaut token issue|check|burn ..." ;;
    esac
}

# daemon: what beaut.service runs. Starts every long-running part of the
# enabled roles; parts not implemented yet are reported and skipped.
cmd_daemon() {
    init_state
    local started=0 r
    for r in $(roles); do
        case "$r" in
            hub)    warn "hub: serve/mail-poll not implemented yet (steps 2, 6)" ;;
            worker) warn "worker: enroll/tunnel not implemented yet (step 3)" ;;
            client) debug "client role has no daemon part" ;;
        esac
    done
    [ "$started" -gt 0 ] || { BEAUT_EXIT=64 die "no runnable role service yet (ROLES=$ROLES)"; }
    wait
}

cmd_tier() {
    if [ $# -eq 0 ]; then
        tier_names | while read -r t; do printf '%-11s %s\n' "$t" "$(tier_spec "$t")"; done
    else
        tier_spec "$1" || die "unknown tier: $1"
    fi
}

main() {
    local roles_override=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--config) [ $# -ge 2 ] || die "$1 needs a file"; BEAUT_CONFIG="$2"; shift 2 ;;
            --roles)     [ $# -ge 2 ] || die "--roles needs a list"; roles_override="$2"; shift 2 ;;
            -v|--verbose) BEAUT_LOG_LEVEL=debug; shift ;;
            -h|--help|help) usage; exit 0 ;;
            --version|version) echo "beaut $BEAUT_VERSION"; exit 0 ;;
            --) shift; break ;;
            -*) die "unknown option: $1 (see beaut --help)" ;;
            *) break ;;
        esac
    done
    export BEAUT_CONFIG BEAUT_LOG_LEVEL 2>/dev/null || true
    [ -n "$roles_override" ] && BEAUT_ROLES="$roles_override"
    load_config

    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        help)        usage ;;
        config)      cmd_config ;;
        roles)       roles ;;
        status)      cmd_status ;;
        user)        cmd_user "$@" ;;
        token)       cmd_token "$@" ;;
        tier)        cmd_tier "$@" ;;
        daemon)      cmd_daemon ;;
        # hub
        serve)       require_role hub;    BEAUT_EXIT=64 not_impl serve "step 2 (lib/http.sh)" ;;
        mail-poll)   require_role hub;    BEAUT_EXIT=64 not_impl mail-poll "step 6 (lib/mail.sh)" ;;
        # worker
        enroll)      require_role worker; BEAUT_EXIT=64 not_impl enroll "step 3 (lib/worker.sh)" ;;
        worker-exec) require_role worker; BEAUT_EXIT=64 not_impl worker-exec "step 3 (lib/worker.sh)" ;;
        # client
        run)         require_role client; BEAUT_EXIT=64 not_impl run "step 4 (lib/hub.sh)" ;;
        vm)          require_role client; BEAUT_EXIT=64 not_impl vm "step 5 (lib/vm.sh)" ;;
        *)           die "unknown command: $cmd (see beaut --help)" ;;
    esac
}

main "$@"
