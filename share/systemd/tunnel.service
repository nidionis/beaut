[Unit]
Description=beaut reverse tunnel to hub
After=network-online.target beaut-worker.service
Wants=network-online.target beaut-worker.service

[Service]
Type=simple
Environment=BEAUT_CONFIG=@CONFIG@
Environment=BEAUT_ENV=@ENVFILE@
ExecStart=@BIN@
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
